# Source data path relative to repo root
SOURCE_DATA_PATH=data/source/drebin_dataset.csv

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_HOST_PORT=5432   # host-side port mapping
POSTGRES_PORT=5432        # inside the container / compose network
POSTGRES_DB=dss150p
POSTGRES_USER=dss150p_user
POSTGRES_PASSWORD=change_me

# Pipeline
PIPELINE_RUN_ID=
